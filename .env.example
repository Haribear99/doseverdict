# DoseVerdict — 본선 API 설정 (실제 키는 .env에만 넣고 절대 커밋하지 않는다)
OPENAI_API_KEY=API_KEY_PLACEHOLDER
OPENAI_BASE_URL=https://dacon-apim-hackathon-0903.azure-api.net/hackathon/openai/v1

# 역할별 모델 (데이콘이 gpt-6 Astra를 열면 여기만 바꾼다)
DV_MODEL_PLANNER=gpt-6-sol
DV_MODEL_REVIEWER=gpt-6-sol
DV_MODEL_EXTRACT=gpt-6-sol
DV_MODEL_BULK=gpt-5.6-luna

# 예산 (토큰)
DV_RUN_TOKEN_BUDGET=150000
DV_TEAM_TOTAL_QUOTA=30000000

# Reviewer 구성(기본 규제 1인; 3인은 regulatory,site,patient) · 근거 재선택(로컬 NLI, 토큰 0)
DV_REVIEWERS=regulatory
DV_EVIDENCE_RERANK=auto   # auto=GPU에서만 / 1=강제 / 0=끔 (CPU는 NLI 1쌍 ~수 초)
